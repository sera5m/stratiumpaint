{
  "name": "stratum",
  "productName": "Stratum",
  "version": "2.12.3",
  "description": "Layered raster image editor in the spirit of Paint.NET, for Linux",
  "main": "electron/main.cjs",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/bundle-standalone.mjs",
    "build:dev": "node scripts/bundle-standalone.mjs --dev",
    "start": "npm run build:dev && electron .",
    "web": "python3 -m http.server 8080 --directory src",
    "test": "node --test test/*.test.mjs",
    "test:gpu": "node --experimental-websocket scripts/gpu-check.mjs && node --experimental-websocket scripts/gpu-check.mjs tools-parity.html && node --experimental-websocket scripts/gpu-check.mjs view-damage.html",
    "bench:brush-engine": "node scripts/brush-engine-bench.mjs",
    "bench:brush": "node --experimental-websocket scripts/gpu-check.mjs paint-bench.html?case=brush",
    "bench:shape": "node --experimental-websocket scripts/gpu-check.mjs paint-bench.html?case=shape",
    "bench:3d": "node --experimental-websocket scripts/gpu-check.mjs paint-bench.html?case=3d",
    "bench:move": "node --experimental-websocket scripts/gpu-check.mjs move-bench.html",
    "profile:ui": "node --experimental-websocket scripts/ui-profile.mjs",
    "uninstall:app": "sh scripts/uninstall.sh",
    "nodes": "node src/js/nodes/cli.js",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12"
  },
  "build": {
    "appId": "com.sera5m.stratum",
    "productName": "Stratum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "synopsis": "Layered raster image editor"
    },
    "win": {
      "target": [
        "zip",
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "deb": {
      "compression": "gz"
    }
  },
  "author": "sera5m <69703832+sera5m@users.noreply.github.com>"
}
